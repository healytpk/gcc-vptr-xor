# Runtime support for the -m32df ABI.  Every file here guards itself with
# __M32DF__, so they contribute nothing to the m32, m64 and mx32 multilibs --
# which keep using glibc untouched.

# The __dualcall call-lowering helper.
LIB2ADD_ST += $(srcdir)/config/i386/dualcall.S

# The minimal C library for this ABI (no glibc, no newlib port exists).
LIB2ADD_ST += $(srcdir)/config/i386/m32df-libc.c

# Startup code for -m32df programs; STARTFILE_SPEC names crt0%O%s.
EXTRA_PARTS += crt0.o
crt0.o: $(srcdir)/config/i386/crt0-m32df.S
	$(gcc_compile) -c $<

# A stub libstdc++.a, for this multilib only.  The g++ driver appends
# -lstdc++ as a command-line argument rather than through a spec, so no spec
# can remove it, and libstdc++ is not built for m32df.  See m32df-stub.c.
#
# The MULTISUBDIR guard matters: EXTRA_PARTS are installed into
# $(libsubdir)$(MULTISUBDIR), and that directory is searched ahead of the
# system library path.  Building this unconditionally would put a stub
# libstdc++.a in the default multilib's directory and shadow the real one for
# -m64 and -m32.
ifeq ($(MULTISUBDIR),/32df)
EXTRA_PARTS += libstdc++.a

m32df-stub.o: $(srcdir)/config/i386/m32df-stub.c
	$(gcc_compile) -c $<

libstdc++.a: m32df-stub.o
	$(AR_CREATE_FOR_TARGET) $@ m32df-stub.o
	$(RANLIB_FOR_TARGET) $@

# Two pieces of C++ support that nothing else installs for this multilib,
# because libstdc++ is not built for it.  Hooked onto libgcc's per-multilib
# install, which is the only install step that runs for m32df.
#
# Every command is prefixed with `-' so that a failure here can never break
# `make install': both are conveniences, and a missing directory is silently
# ignored by the compiler.
install-leaf: install-m32df-cxx-support

.PHONY: install-m32df-cxx-support
install-m32df-cxx-support:
#	The substitute <iostream>, <ios>, <ostream> and <iomanip>.  They go in
#	the compiler's own tree, where CC1PLUS_SPEC points -m32df C++ compiles
#	with -iwithprefixbefore; that resolves against the -iprefix the driver
#	already passes, and is searched ahead of the standard C++ directories.
	-$(mkinstalldirs) $(DESTDIR)$(libsubdir)/include/c++/m32df
	-cp -R $(srcdir)/../contrib/m32df/include/. \
	   $(DESTDIR)$(libsubdir)/include/c++/m32df/
#	<bits/c++config.h>.  It is generated by libstdc++'s configure, per
#	multilib, so there is no m32df copy.  The m32 one is correct here --
#	both are i386/ILP32, and the file records the data model and type
#	widths, not the C library.  A symlink rather than a copy because libgcc
#	is installed before libstdc++, so the target does not exist yet; it
#	resolves once libstdc++ has installed.  If the m32 multilib was not
#	built the link dangles, and libstdc++ headers stay unavailable.
	-$(mkinstalldirs) \
	   $(DESTDIR)$(prefix)/include/c++/$(version)/$(real_host_noncanonical)
	-test -e $(DESTDIR)$(prefix)/include/c++/$(version)/$(real_host_noncanonical)/32df \
	   || ln -s 32 \
	      $(DESTDIR)$(prefix)/include/c++/$(version)/$(real_host_noncanonical)/32df
endif
